# ── Neon.tech PostgreSQL ─────────────────────────────
# Copy your connection string from the Neon dashboard:
# Project → Connection Details → Connection string
DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ── JWT ──────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# ── Admin ────────────────────────────────────────────
# First admin account — created automatically on first run
ADMIN_EMAIL=admin@vtos.local
ADMIN_PASSWORD=ChangeMe123!

# ── Server ───────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── CORS — comma-separated list of allowed origins ───
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:5500,http://localhost:5500

# ── Email (Nodemailer / Gmail) ────────────────────────
# EMAIL_USER: your Gmail address
# EMAIL_PASS: Gmail App Password (NOT your regular password)
#   → Google Account → Security → 2-Step Verification → App passwords
EMAIL_USER=vtechonlinesolutions@gmail.com
EMAIL_PASS=your_gmail_app_password_here

# ── App URL (used in password reset emails) ───────────
# Set this to your custom domain once it's live:
APP_URL=https://www.vots.co.za

# ════════════════════════════════════════════════════════
# VERCEL PRODUCTION — set these in Vercel Dashboard:
#   Project → Settings → Environment Variables
# ════════════════════════════════════════════════════════
#
# Variable              Value
# ──────────────────    ──────────────────────────────────────────────────────
# DATABASE_URL          (same Neon connection string)
# JWT_SECRET            (same secret — do NOT regenerate in production)
# JWT_EXPIRES_IN        7d
# NODE_ENV              production
# CORS_ORIGINS          https://www.vots.co.za,https://vots.co.za,https://vtos-stevenvectors-projects.vercel.app
# APP_URL               https://www.vots.co.za
# EMAIL_USER            vtechonlinesolutions@gmail.com
# EMAIL_PASS            (Gmail App Password)
#
# NOTE: ADMIN_EMAIL and ADMIN_PASSWORD are only used during
#       initial DB migration (migrate.js). They do NOT need
#       to be set in Vercel for the running app.
# ════════════════════════════════════════════════════════
